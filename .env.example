# Copy to .env (never commit it) and run: node --env-file=.env agent/cli.js "..."
# Required only for the AI agent (not for the web app, the tests or the CLI connectors):
ANTHROPIC_API_KEY=
# Optional, paid: Google Places connector
GOOGLE_PLACES_API_KEY=
# Optional: higher rate limits on Socrata open-data portals (datos.gov.co)
SOCRATA_APP_TOKEN=
